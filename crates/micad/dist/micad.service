[Unit]
Description=mica management daemon
After=dbus.service
# main.rs deliberately hard-fails when STATE is unwritable; without this
# ordering that policy can race the mount, and Restart=on-failure under the
# default start-rate limit would park the daemon in "failed" on a slow disk.
RequiresMountsFor=/var/lib/mica /mica

[Service]
Type=dbus
BusName=com.mica.micad
ExecStart=/usr/bin/micad
Restart=on-failure

# Sandboxing for a root daemon. micad must keep root and broad file access —
# it rewrites /etc/shadow, renders under /run/mica and /run/systemd/network,
# writes ~/.ssh/authorized_keys into /root and /home/mica, and owns STATE — so
# ProtectSystem=, ProtectHome= and a capability bounding set are not
# candidates. Everything below is: micad execs nothing setuid, needs no
# realtime, maps nothing writable-executable, and speaks only unix/netlink/inet
# sockets (zbus, sd-notify, reconciler bus calls).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
