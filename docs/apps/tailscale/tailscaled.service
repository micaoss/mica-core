[Unit]
Description=Tailscale node agent
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/mica/apps/tailscale/app.env
RuntimeDirectory=tailscale
ExecStart=/mica/apps/tailscale/current/files/tailscaled --state=${APP_DATA}/tailscaled.state --socket=${TS_SOCKET} --port=41641
Restart=on-failure

[Install]
WantedBy=multi-user.target
